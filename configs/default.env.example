# Copy this file to .env. Never commit the populated .env file.
OPENAI_API_KEY=YOUR_API_KEY
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL_NAME=YOUR_MODEL_NAME

# Local planner (OpenAI-compatible API)
ADAPTVPR_PLANNER_API_KEY=local-placeholder
ADAPTVPR_PLANNER_API_BASE=http://127.0.0.1:23002/v1
ADAPTVPR_PLANNER_MODEL=qwen3-vl-4b-instruct-remote

# Runtime dependency paths
VISMATCH_ROOT=../vismatch

# Reflection policy default used by library callers. The public CLI exposes
# --reflection on|off and --max-reflections explicitly. Global always runs once.
ADAPTVPR_MAX_GENERATIONS=4

# Optional generation services
ICLIGHT_API_URL=http://127.0.0.1:8002/generate
LIGHTX2V_API_URL=http://127.0.0.1:8001/generate
# Official source checkouts. For a GitHub commit tarball, place its exact commit
# in <source-root>/.adaptvpr-source-revision. The adapters reject other revisions.
# https://github.com/lllyasviel/IC-Light
ICLIGHT_ROOT=/path/to/IC-Light
ICLIGHT_GIT_COMMIT=bcf3f29ca85be8a4686215f477b546f5030be8b7
# https://huggingface.co/stable-diffusion-v1-5/stable-diffusion-v1-5
ICLIGHT_BASE_MODEL_PATH=/path/to/stable-diffusion-v1-5
# https://huggingface.co/lllyasviel/ic-light/blob/9cad1878695f546a7fb9eaca14e2a89131ba5ffe/iclight_sd15_fc.safetensors
ICLIGHT_MODEL_PATH=/path/to/iclight_sd15_fc.safetensors
# https://github.com/ModelTC/LightX2V
LIGHTX2V_ROOT=/path/to/LightX2V
LIGHTX2V_GIT_COMMIT=522609ecc121b49c20d201b3f00c3dc052821bce
# Exact public Local/Dual reference stack used by adapters/lightx2v_qwen_image_edit.py
LIGHTX2V_MODEL_ID=Qwen/Qwen-Image-Edit-2511
LIGHTX2V_MODEL_REVISION=6f3ccc0b56e431dc6a0c2b2039706d7d26f22cb9
LIGHTX2V_MODEL_PATH=/path/to/Qwen-Image-Edit-2511
LIGHTX2V_LORA_ID=lightx2v/Qwen-Image-Edit-2511-Lightning
LIGHTX2V_LORA_REVISION=d74eba145674fd7e31b949324e148e21e7118abd
LIGHTX2V_LORA_PATH=/path/to/Qwen-Image-Edit-2511-Lightning-4steps-V1.0-bf16.safetensors
LIGHTX2V_INFER_STEPS=4
LIGHTX2V_GUIDANCE_SCALE=1.0
LIGHTX2V_ATTN_MODE=torch_sdpa
LIGHTX2V_CPU_OFFLOAD=1
ICLIGHT_AUTO_START=0
LIGHTX2V_AUTO_START=0

# Real runs invoked through run.py are strict by default. The --mock CLI flag
# overrides this value only for an explicit offline smoke test.
ADAPTVPR_DISABLE_MOCK=1

# Verifier implementations
ADAPTVPR_CLIP_MODEL_NAME=openai/clip-vit-base-patch32
ADAPTVPR_CLIP_LOCAL_FILES_ONLY=1
ADAPTVPR_MATCHER_NAME=superpoint-lightglue
